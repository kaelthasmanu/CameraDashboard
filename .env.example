# Copy to .env and replace every CHANGE_ME value before starting the stack.
# This template uses Docker Compose service names; see docs/development-setup.md
# to run the backend/frontend locally with SQLite instead.

# PostgreSQL (Docker Compose)
POSTGRES_USER=camera
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=camera_dashboard
DATABASE_URL=postgresql+asyncpg://camera:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/camera_dashboard

# Browser origins: add the exact URL used to open the dashboard on your LAN.
CORS_ORIGINS=http://localhost:5173
# Optional IP-based allow-list. If CIDRs are set, CIDR_PORTS is required.
CORS_ORIGIN_CIDRS=
CORS_ORIGIN_CIDR_PORTS=

# Recording storage. Set FTP/SFTP details only when using remote storage.
STORAGE_BACKEND=local
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_ANONYMOUS=false
FTP_ROOT=/
FTP_RECORDING_DURATION_SECONDS=1800
FTP_CAMERA_PREFIXES=

# MediaMTX services on the Docker Compose network
MEDIAMTX_CONFIG_PATH=/app/mediamtx.yml
MEDIAMTX_API_URL=http://mediamtx:9997
MEDIAMTX_API_USERNAME=dashboard-api
MEDIAMTX_API_PASSWORD=REPLACE_WITH_MEDIAMTX_API_PASSWORD
MEDIAMTX_API_TIMEOUT_SECONDS=2.0
# These URLs are used by browsers, so use localhost only on the same machine.
# For LAN access, replace localhost with the server IP/DNS name.
MEDIAMTX_WEBRTC_PUBLIC_URL=http://localhost:8889
MEDIAMTX_WEBRTC_ADDITIONAL_HOSTS=localhost
FRONTEND_API_URL=http://localhost:8000/api/v1
VITE_API_URL=http://localhost:8000/api/v1

# Application authentication. Replace both values before exposing the app.
# Generate a secret with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_A_RANDOM_64_CHARACTER_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_MINUTES=60
AUTH_COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Person detection stays off for the initial dashboard startup.
PERSON_DETECTION_ENABLED=false
PERSON_DETECTION_MODEL=yolo11m.pt
PERSON_DETECTION_CONFIDENCE=0.20
PERSON_DETECTION_IMAGE_SIZE=1280
PERSON_DETECTION_AUGMENT=true
PERSON_DETECTION_MAX_DETECTIONS=100
PERSON_DETECTION_FRAME_INTERVAL_SECONDS=0.25
PERSON_DETECTION_ALERT_SECONDS=2
